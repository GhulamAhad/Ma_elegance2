# Production PostgreSQL (Neon, Supabase, Railway, Render, etc.)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Admin account - choose a strong password before deployment
ADMIN_EMAIL=admin@maelegance.pk
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=30

# Your deployed frontend URL(s), comma separated
CORS_ORIGINS=https://your-store.vercel.app

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
